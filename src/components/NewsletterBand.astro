---
interface Props {
  id?: string;
}
const { id } = Astro.props;
---

<div class="newsletter-band" id={id}>
  <div class="nl-inner">

    <!-- Left: headline + description -->
    <div class="nl-left">
      <h2 class="nl-headline">Build the Business.<br />Run the Play.</h2>
      <p class="nl-sub">The Playbook is the strategy resource for agents who want to build, grow, and scale. No pesky upsells, no vendor agendas, or fluff.</p>
    </div>

    <!-- Right: stats → divider → email form -->
    <div class="nl-right">
      <div class="nl-stat-row">
        <div class="nl-stat">
          <div class="nl-stat-num">One source</div>
          <div class="nl-stat-label">For Real Estate Pros</div>
        </div>
        <div class="nl-stat">
          <div class="nl-stat-num">Zero fluff</div>
          <div class="nl-stat-label">Practitioner-Written</div>
        </div>
        <div class="nl-stat">
          <div class="nl-stat-num">Every week</div>
          <div class="nl-stat-label">In Your Inbox</div>
        </div>
      </div>
      <div class="nl-divider"></div>
      <div class="nl-form">
        <input class="nl-input" type="email" placeholder="your@email.com" />
        <button class="nl-btn" type="button">Subscribe to the Newsletter</button>
      </div>
      <div class="nl-confirm">
        <span class="nl-confirm-check">✓</span>
        <span class="nl-confirm-text">You're in. Check your inbox to confirm your subscription.</span>
      </div>
    </div>

  </div>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('.newsletter-band').forEach(function (band) {
      if (band.dataset.wired) return;          // idempotent: never double-bind
      band.dataset.wired = '1';
      var input   = band.querySelector('.nl-input');
      var btn     = band.querySelector('.nl-btn');
      var form    = band.querySelector('.nl-form');
      var confirm = band.querySelector('.nl-confirm');
      if (!input || !btn || !form || !confirm) return;

      function submit() {
        var email = input.value.trim();
        if (!email || !email.includes('@')) {
          input.focus();
          input.style.outline = '2px solid #e00055';
          setTimeout(function () { input.style.outline = ''; }, 1200);
          return;
        }
        // Show confirmation immediately; subscribe in the background (graceful —
        // confirmation stands even if the request fails, e.g. in local dev).
        form.style.display = 'none';
        confirm.classList.add('active');
        fetch('/.netlify/functions/newsletter-subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, source: 'newsletter-band' }),
        }).catch(function (e) { console.warn('[subscribe] API call failed:', e); });
      }

      btn.addEventListener('click', submit);
      input.addEventListener('keydown', function (e) { if (e.key === 'Enter') submit(); });
    });
  })();
</script>

<style>
  .newsletter-band {
    background: var(--yellow);
    border-top: 3px solid var(--black);
    border-bottom: 3px solid var(--black);
  }
  .nl-inner {
    max-width: 1280px; margin: 0 auto; padding: 48px 40px;
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 64px; align-items: center;
  }

  /* Left column */
  .nl-headline {
    font-family: 'Bebas Neue', cursive; font-size: 72px; line-height: 0.88;
    letter-spacing: 0.02em; color: var(--black); margin-bottom: 16px;
  }
  .nl-sub {
    font-size: 16px; color: rgba(0,0,0,0.65); line-height: 1.6; max-width: 420px;
  }

  /* Right column */
  .nl-right { display: flex; flex-direction: column; gap: 12px; }
  .nl-stat-row { display: flex; gap: 32px; }
  .nl-stat { display: flex; flex-direction: column; }
  .nl-stat-num {
    font-family: 'Bebas Neue', cursive; font-size: 32px; line-height: 1;
    color: var(--black); letter-spacing: 0.02em;
  }
  .nl-stat-label {
    font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 600;
    letter-spacing: 0.1em; text-transform: uppercase; color: rgba(0,0,0,0.5);
    margin-top: 4px;
  }
  .nl-divider { width: 100%; height: 1px; background: rgba(0,0,0,0.15); }
  .nl-form { display: flex; gap: 0; align-items: stretch; }
  .nl-input {
    background: var(--white); border: none; font-family: 'DM Sans', sans-serif;
    font-size: 14px; color: var(--charcoal); padding: 0 18px;
    flex: 1; outline: none; min-width: 0; height: 52px;
  }
  .nl-input::placeholder { color: #aaa; }
  .nl-btn {
    background: var(--black); color: var(--yellow);
    font-family: 'Bebas Neue', cursive; font-size: 18px; letter-spacing: 0.1em;
    padding: 14px 28px; cursor: pointer; white-space: nowrap; flex-shrink: 0;
    border: none; transition: background 0.15s;
  }
  .nl-btn:hover { background: #222; }
  .nl-confirm { display: none; align-items: center; gap: 12px; min-height: 52px; }
  .nl-confirm.active { display: flex; }
  .nl-confirm-check {
    width: 28px; height: 28px; background: var(--black); color: var(--yellow);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    font-size: 15px;
  }
  .nl-confirm-text {
    font-family: 'DM Sans', sans-serif; font-size: 15px; color: var(--black); font-weight: 600;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .nl-inner { grid-template-columns: 1fr; gap: 36px; }
    .nl-headline { font-size: 56px; }
  }
  @media (max-width: 600px) {
    .nl-inner { padding: 40px 20px; }
    .nl-headline { font-size: 48px; }
    .nl-stat-row { gap: 20px; }
    .nl-stat-num { font-size: 40px; }
    .nl-form { flex-direction: column; }
    .nl-input { height: 48px; }
    .nl-btn { padding: 14px 20px; font-size: 16px; }
  }
</style>
