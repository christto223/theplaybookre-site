---
import { PILLARS } from '../data/pillars';
const col1Pillars = PILLARS.slice(0, 4);
const col2Pillars = PILLARS.slice(4);
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-top">

      <!-- Brand + social -->
      <div class="footer-brand">
        <div class="footer-logo">THE <span>PLAYBOOK</span> RE</div>
        <div class="footer-tagline">
          Strategy and systems for real estate agents who are serious about
          building a real business. No coaching upsells. No vendor agendas.
          Just the playbook.
        </div>
        <div class="footer-social">
          <a href="https://www.threads.net/@chrislinsell" target="_blank" rel="noopener" class="social-icon" aria-label="Threads">
            <svg viewBox="0 0 192 192" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
