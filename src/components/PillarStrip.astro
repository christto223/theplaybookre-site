---
import { PILLARS } from '../data/pillars';

interface Props {
  activePillar?: string;
}
const { activePillar } = Astro.props;
---

<nav class="pillar-strip" aria-label="Topic navigation">
  <div class="pillar-strip-inner">
    <a href="/" class:list={['pillar-pill', { active: !activePillar }]}>All</a>
    {PILLARS.map(p => (
      <a
        href={`/${p.slug}/`}
        class:list={['pillar-pill', { active: p.slug === activePillar }]}
      >
        {p.shortName}
      </a>
    ))}
  </div>
</nav>

<style>
  .pillar-strip {
    background: var(--yellow);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .pillar-strip-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    gap: 0;
    white-space: nowrap;
  }
  .pillar-pill {
    font-family: 'Bebas Neue', cursive;
    font-size: 13px;
    letter-spacing: 0.1em;
    color: rgba(0, 0, 0, 0.55);
    padding: 12px 18px;
    white-space: nowrap;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: color 0.15s, background 0.15s;
  }
  .pillar-pill:hover {
    color: var(--black);
    background: rgba(0, 0, 0, 0.08);
  }
  .pillar-pill.active {
    background: var(--black);
    color: var(--yellow);
  }
</style>
