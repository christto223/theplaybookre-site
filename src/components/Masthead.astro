---
interface Props {
  activeNav?: 'start-here' | 'toolkit' | 'about';
}
const { activeNav } = Astro.props;
---

<header class="masthead" id="masthead">
  <div class="masthead-inner">
    <a href="/" class="logo">
      <span class="logo-the">THE</span>
      <span class="logo-main">PLAYBOOK</span>
      <span class="logo-re">RE</span>
    </a>

    <!-- Right-side slot: nav and search bar share the same grid area -->
    <div class="masthead-right">

      <!-- Normal nav -->
      <ul class="masthead-nav" id="masthead-nav">
        <li class:list={[{ 'nav-active': activeNav === 'start-here' }]}>
          <a href="/start-here/">Start Here</a>
        </li>
        <li class:list={[{ 'nav-active': activeNav === 'toolkit' }]}>
          <a href="/toolkit/">The Toolkit</a>
        </li>
        <li class:list={[{ 'nav-active': activeNav === 'about' }]}>
          <a href="/about/">About</a>
        </li>
        <li class="nav-search" id="nav-search-btn" aria-label="Search">
          <svg width="15" height="15" viewBox="0 0 15 15" fill="none">
            <circle cx="6.5" cy="6.5" r="5" stroke="currentColor" stroke-width="1.5"/>
            <line x1="10.4" y1="10.4" x2="13.5" y2="13.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </li>
        <li class="nav-cta"><button id="masthead-nl-btn">Get the Newsletter</button></li>
      </ul>

      <!-- Search bar (crossfades in over the nav) -->
      <div class="masthead-search-row" id="masthead-search-row">
        <svg width="15" height="15" viewBox="0 0 15 15" fill="none" class="msr-icon">
          <circle cx="6.5" cy="6.5" r="5" stroke="currentColor" stroke-width="1.5"/>
          <line x1="10.4" y1="10.4" x2="13.5" y2="13.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <input
          type="text"
          id="nav-search-input"
          class="msr-input"
          placeholder="Search playbooks..."
          autocomplete="off"
          spellcheck="false"
        />
        <button id="nav-search-close" class="msr-close" aria-label="Close search">
          <svg width="11" height="11" viewBox="0 0 11 11" fill="none">
            <line x1="1" y1="1" x2="10" y2="10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="10" y1="1" x2="1" y2="10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

    </div>
  </div>
</header>

<!-- Search results panel — fixed below masthead, populated by JS -->
<div class="nav-search-results" id="nav-search-results"></div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var masthead    = document.getElementById('masthead');
    var searchBtn   = document.getElementById('nav-search-btn');
    var searchInput = document.getElementById('nav-search-input');
    var searchClose = document.getElementById('nav-search-close');
    var results     = document.getElementById('nav-search-results');
    var nlBtn       = document.getElementById('masthead-nl-btn');

    // Newsletter button delegates to footer modal
    if (nlBtn) {
      nlBtn.addEventListener('click', function () {
        var footerBtn = document.getElementById('footer-nl-btn');
        if (footerBtn) footerBtn.click();
      });
    }

    // ── Search ──────────────────────────────────────────────
    var articles = null;
    var isOpen   = false;

    function openSearch() {
      isOpen = true;
      masthead.classList.add('search-active');
      setTimeout(function () { searchInput.focus(); }, 180);
      if (!articles) loadIndex();
    }

    function closeSearch() {
      isOpen = false;
      masthead.classList.remove('search-active');
      searchInput.value = '';
      results.innerHTML = '';
      results.classList.remove('has-results');
    }

    function loadIndex() {
      fetch('/search.json')
        .then(function (r) { return r.json(); })
        .then(function (data) {
          articles = data;
          if (searchInput.value.trim()) runSearch(searchInput.value);
        })
        .catch(function (e) { console.warn('[search] index load failed:', e); });
    }

    function runSearch(raw) {
      var q = raw.trim().toLowerCase();
      if (!articles || !q) {
        results.innerHTML = '';
        results.classList.remove('has-results');
        return;
      }
      var hits = articles.filter(function (a) {
        return a.title.toLowerCase().includes(q) ||
               (a.description && a.description.toLowerCase().includes(q));
      }).slice(0, 8);

      if (hits.length === 0) {
        results.innerHTML = '<div class="nsr-empty">No playbooks matched "' + raw.trim() + '"</div>';
      } else {
        results.innerHTML = hits.map(function (a) {
          var pillar = (a.pillar || '').replace(/-/g, ' ')
            .replace(/\b\w/g, function (c) { return c.toUpperCase(); });
          return '<a href="' + a.url + '" class="nsr-item">' +
            '<div class="nsr-pillar">' + pillar + '</div>' +
            '<div class="nsr-title">' + a.title + '</div>' +
            '</a>';
        }).join('');
      }
      results.classList.add('has-results');
    }

    if (searchBtn) searchBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      openSearch();
    });
    if (searchClose) searchClose.addEventListener('click', closeSearch);

    if (searchInput) {
      searchInput.addEventListener('input',   function () { runSearch(this.value); });
      searchInput.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { closeSearch(); return; }
        if (e.key === 'Enter') {
          var first = results.querySelector('.nsr-item');
          if (first) first.click();
        }
      });
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && isOpen) closeSearch();
    });
    document.addEventListener('click', function (e) {
      if (isOpen && !masthead.contains(e.target) && !results.contains(e.target))
        closeSearch();
    });
  });
</script>

<style>
  .masthead {
    background: var(--black);
    border-bottom: 4px solid var(--yellow);
    position: sticky;
    top: 0;
    z-index: 200;
  }
  .masthead-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 40px;
    height: 68px;
    display: flex;
    align-items: center;
    gap: 32px;
  }

  /* Logo */
  .logo {
    font-family: 'Bebas Neue', cursive;
    line-height: 1;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    text-decoration: none;
  }
  .logo-the  { color: var(--yellow); font-size: 16px; letter-spacing: 0.15em; }
  .logo-main { color: var(--white);  font-size: 30px; letter-spacing: 0.04em; }
  .logo-re   { color: var(--yellow); font-size: 16px; letter-spacing: 0.15em; }

  /* Right-side wrapper — both nav and search share one grid area */
  .masthead-right {
    flex: 1;
    display: grid;
    grid-template-areas: "slot";
    align-items: center;
    justify-items: end;
    min-width: 0;
  }
  .masthead-nav,
  .masthead-search-row {
    grid-area: slot;
  }

  /* ── Normal nav ── */
  .masthead-nav {
    display: flex;
    gap: 28px;
    list-style: none;
    align-items: center;
    opacity: 1;
    transform: translateX(0);
    transition: opacity 0.18s ease, transform 0.18s ease;
    pointer-events: all;
  }
  .masthead.search-active .masthead-nav {
    opacity: 0;
    transform: translateX(12px);
    pointer-events: none;
  }

  .masthead-nav li a,
  .masthead-nav li {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #999;
    cursor: pointer;
    white-space: nowrap;
    text-decoration: none;
  }
  .masthead-nav li:hover > a,
  .masthead-nav li:hover { color: var(--yellow); }
  .masthead-nav .nav-active > a,
  .masthead-nav .nav-active { color: var(--yellow); }

  .masthead-nav .nav-search {
    width: 32px; height: 32px;
    border: 1px solid #333;
    display: flex; align-items: center; justify-content: center;
    color: #777; cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .masthead-nav .nav-search:hover {
    border-color: var(--yellow);
    color: var(--yellow);
  }
  .masthead-nav .nav-cta { background: var(--yellow); padding: 8px 20px; }
  .masthead-nav .nav-cta button {
    font-family: 'Bebas Neue', cursive;
    font-size: 15px;
    letter-spacing: 0.09em;
    color: var(--black);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .masthead-nav .nav-cta:hover { background: #e8be00; }

  /* ── Search row ── */
  .masthead-search-row {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    opacity: 0;
    transform: translateX(-12px);
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
    border-bottom: 1px solid #2a2a2a;
    padding-bottom: 2px;
  }
  .masthead.search-active .masthead-search-row {
    opacity: 1;
    transform: translateX(0);
    pointer-events: all;
  }

  .msr-icon { color: var(--yellow); flex-shrink: 0; width: 15px; height: 15px; }
  .msr-input {
    flex: 1; min-width: 0;
    background: none; border: none; outline: none;
    font-family: 'Inter', sans-serif;
    font-size: 14px; font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--white);
  }
  .msr-input::placeholder { color: #444; }
  .msr-close {
    width: 28px; height: 28px;
    background: none; border: 1px solid #2a2a2a;
    color: #555;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    transition: border-color 0.15s, color 0.15s;
  }
  .msr-close:hover { border-color: var(--yellow); color: var(--yellow); }

  /* ── Results panel (fixed below masthead) ── */
  .nav-search-results {
    position: fixed;
    top: 72px; /* 68px masthead + 4px border */
    left: 0; right: 0;
    background: #0e0e0e;
    border-bottom: 3px solid var(--yellow);
    z-index: 199;
    display: none;
    overflow-y: auto;
    max-height: 60vh;
    box-shadow: 0 16px 48px rgba(0,0,0,0.7);
  }
  .nav-search-results.has-results { display: block; }

  .nsr-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 14px 40px;
    border-bottom: 1px solid #1a1a1a;
    text-decoration: none;
    color: inherit;
    transition: background 0.1s;
  }
  .nsr-item:last-child { border-bottom: none; }
  .nsr-item:hover { background: #161616; }
  .nsr-pillar {
    font-family: 'Bebas Neue', cursive;
    font-size: 10px; letter-spacing: 0.22em;
    color: var(--yellow);
  }
  .nsr-title {
    font-family: 'Bebas Neue', cursive;
    font-size: 20px; letter-spacing: 0.02em;
    color: var(--white); line-height: 1;
  }
  .nsr-item:hover .nsr-title { color: var(--yellow); }

  .nsr-empty {
    padding: 20px 40px;
    font-family: 'Inter', sans-serif;
    font-size: 13px; color: #555;
  }
</style>
