---
import SEOHead from '../components/SEOHead.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  publishDate?: Date;
  schema?: object | object[];
  noindex?: boolean;
  activeNav?: 'start-here' | 'toolkit' | 'about';
}

const { activeNav, ...seoProps } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead {...seoProps} />
    {import.meta.env.PROD && (
      <Fragment>
        {/* Google Analytics (GA4) — loaded on production builds only */}
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-N31XKG6F3M"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', 'G-N31XKG6F3M');
        </script>
      </Fragment>
    )}
  </head>
  <body>
    <Masthead activeNav={activeNav} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
