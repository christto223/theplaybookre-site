---
import SEOHead from '../components/SEOHead.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  publishDate?: Date;
  schema?: object | object[];
  activeNav?: 'start-here' | 'toolkit' | 'about';
}

const { activeNav, ...seoProps } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead {...seoProps} />
  </head>
  <body>
    <Masthead activeNav={activeNav} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
