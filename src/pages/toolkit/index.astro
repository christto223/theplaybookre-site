---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterBand from '../../components/NewsletterBand.astro';

const allResources = await getCollection('toolkit');
const sorted = allResources.sort((a, b) => a.data.order - b.data.order);

const featuredResource = sorted.find(r => r.data.featured) ?? sorted[0];
const gridResources = sorted.filter(r => r.id !== featuredResource?.slug);

function badgeClass(type: string) {
  const map: Record<string, string> = {
    template: 'badge-template',
    script: 'badge-script',
    checklist: 'badge-checklist',
    calculator: 'badge-calculator',
    guide: 'badge-guide',
  };
  return map[type] ?? 'badge-template';
}

function capitalize(s: string) {
  return s.charAt(0).toUpperCase() + s.slice(1);
}

// Serialize resource data for client-side modal JS
const resourcesData = Object.fromEntries(
  sorted.map(r => [
    r.id,
    {
      type: capitalize(r.data.resourceType),
      typeBadge: badgeClass(r.data.resourceType),
      pillar: r.data.pillar,
      title: r.data.title,
      desc: r.data.description,
      includes: r.data.includes ?? [],
      format: r.data.format,
    }
  ])
);

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "The Toolkit — The Playbook RE",
  "description": "Templates, scripts, checklists, and tools for real estate agents, built from real experience in the field. No filler. Every resource is free.",
  "url": "https://theplaybookre.com/toolkit/",
  "isPartOf": { "@type": "WebSite", "name": "The Playbook RE", "url": "https://theplaybookre.com" },
  "author": { "@type": "Person", "name": "Chris Linsell" }
};
---

<BaseLayout
  title="The Toolkit — Templates, Scripts & Resources — The Playbook RE"
  description="Templates, scripts, checklists, and tools built from real experience in the field. No content briefs, no filler. Every resource in The Toolkit is free — enter your email and we'll send it directly to you."
  activeNav="toolkit"
  schema={schema}
>
  <!-- PAGE HERO -->
  <div class="page-hero">
    <div class="page-hero-inner">
      <div>
        <div class="hero-eyebrow">The Playbook RE</div>
        <h1 class="hero-h1">The <em>Toolkit</em>.</h1>
        <p class="hero-sub">Templates, scripts, checklists, and tools built from real experience in the field. No content briefs, no filler. Every resource is free. Enter your email and it goes straight to your inbox.</p>
      </div>
      <div class="hero-right">
        <div class="hero-stat-row">
          <div>
            <div class="hero-stat-num">{allResources.length}</div>
            <div class="hero-stat-label">Resources available now</div>
          </div>
          <div class="hero-stat-divider"></div>
          <div>
            <div class="hero-stat-num">Free</div>
            <div class="hero-stat-label">Always. No catch.</div>
          </div>
          <div class="hero-stat-divider"></div>
          <div>
            <div class="hero-stat-num">Inbox</div>
            <div class="hero-stat-label">Delivered directly to you</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- HOW IT WORKS BAR -->
  <div class="how-bar">
    <div class="how-bar-inner">
      <div class="how-label">How it works</div>
      <div class="how-steps">
        <div class="how-step">
          <div class="how-step-num">01</div>
          <div class="how-step-text"><strong>Find a resource.</strong> Browse by type or scroll the catalog.</div>
        </div>
        <div class="how-step">
          <div class="how-step-num">02</div>
          <div class="how-step-text"><strong>Enter your email.</strong> One field. Takes five seconds.</div>
        </div>
        <div class="how-step">
          <div class="how-step-num">03</div>
          <div class="how-step-text"><strong>Check your inbox.</strong> We send it directly. No download links, no redirect pages.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- FEATURED RESOURCE -->
  {featuredResource && (
    <div class="featured-section">
      <div class="featured-inner">
        <div class="section-label">Featured Resource</div>
        <div class="featured-card">
          <div class="featured-content">
            <div class="featured-badges">
              <span class={`resource-type-badge ${badgeClass(featuredResource.data.resourceType)}`}>
                {capitalize(featuredResource.data.resourceType)}
              </span>
              <span class="pillar-badge">{featuredResource.data.pillar}</span>
            </div>
            <div class="featured-title">{featuredResource.data.title}</div>
            <p class="featured-desc">{featuredResource.data.description}</p>
            {featuredResource.data.includes && featuredResource.data.includes.length > 0 && (
              <div class="featured-includes">
                <div class="includes-label">What's included</div>
                <div class="includes-list">
                  {featuredResource.data.includes.map(item => (
                    <div class="includes-item">
                      <div class="includes-dot"></div>
                      {item}
                    </div>
                  ))}
                </div>
              </div>
            )}
            <button class="resource-cta-btn" data-resource-id={featuredResource.slug}>
              Send Me This →
            </button>
          </div>
          <div class="featured-visual">
            <div class="doc-preview">
              <div class="doc-preview-header"></div>
              <div class="doc-line yellow"></div>
              <div class="doc-line full"></div>
              <div class="doc-line medium"></div>
              <div class="doc-line short"></div>
              <div style="height:12px"></div>
              <div class="doc-row">
                <div class="doc-cell"></div>
                <div class="doc-cell filled"></div>
                <div class="doc-cell"></div>
              </div>
              <div class="doc-row">
                <div class="doc-cell filled"></div>
                <div class="doc-cell"></div>
                <div class="doc-cell filled"></div>
              </div>
              <div class="doc-row">
                <div class="doc-cell"></div>
                <div class="doc-cell filled"></div>
                <div class="doc-cell filled"></div>
              </div>
              <div style="height:12px"></div>
              <div class="doc-line full"></div>
              <div class="doc-line medium"></div>
            </div>
            <div class="featured-visual-label">{featuredResource.data.format} · Immediate Delivery</div>
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- CATALOG -->
  <div class="catalog-section">
    <div class="catalog-inner">
      <div class="catalog-header">
        <div class="catalog-h2">All Resources</div>
        <div class="filter-bar">
          <button class="filter-btn active" data-filter="all">All</button>
          <button class="filter-btn" data-filter="template">Templates</button>
          <button class="filter-btn" data-filter="script">Scripts</button>
          <button class="filter-btn" data-filter="checklist">Checklists</button>
          <button class="filter-btn" data-filter="calculator">Calculators</button>
          <button class="filter-btn" data-filter="guide">Guides</button>
        </div>
      </div>

      <div class="resource-grid" id="resource-grid">
        {gridResources.map(resource => (
          <div class="resource-card" data-type={resource.data.resourceType}>
            <div class="resource-card-badges">
              <span class={`resource-type-badge ${badgeClass(resource.data.resourceType)}`}>
                {capitalize(resource.data.resourceType)}
              </span>
              <span class="pillar-badge">{resource.data.pillar}</span>
            </div>
            <div class="resource-card-title">{resource.data.title}</div>
            <p class="resource-card-desc">{resource.data.description}</p>
            <div class="resource-card-footer">
              <div class="resource-card-meta">{resource.data.format}</div>
              <button class="resource-get-btn" data-resource-id={resource.slug}>Send Me This →</button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- COMING SOON BAND -->
  <div class="coming-soon">
    <div class="coming-soon-inner">
      <p class="coming-soon-text">New resources show up when they're built and ready, on no fixed schedule. <strong>Every tool in this catalog has been used in a real business.</strong> If there's something specific you'd find useful, let me know.</p>
      <button class="suggest-btn">Suggest a Resource →</button>
    </div>
  </div>

  <!-- NEWSLETTER BAND -->
  <NewsletterBand />

  <!-- RESOURCE MODAL -->
  <div class="modal-overlay" id="modal-overlay">
    <div class="modal">
      <button class="modal-close" id="modal-close-btn">×</button>

      <!-- Request state -->
      <div id="modal-request">
        <div class="modal-badges">
          <span class="resource-type-badge" id="modal-type-badge">Template</span>
          <span class="pillar-badge" id="modal-pillar-badge">Business Systems</span>
        </div>
        <div class="modal-title" id="modal-title">Loading...</div>
        <p class="modal-desc" id="modal-desc"></p>
        <div class="modal-includes" id="modal-includes-wrap">
          <span class="modal-includes-label">What's included</span>
          <div class="modal-includes-list" id="modal-includes-list"></div>
        </div>
        <hr class="modal-divider" />
        <span class="modal-form-label">Enter your email and we'll send it right over</span>
        <div class="modal-form">
          <input type="email" class="modal-input" id="modal-email" placeholder="your@email.com" />
          <button class="modal-submit" id="modal-submit-btn">Send Me This →</button>
        </div>
        <p class="modal-fine">Free. Delivered to your inbox. No spam — ever.</p>
      </div>

      <!-- Confirmation state -->
      <div class="modal-confirm" id="modal-confirm">
        <div class="modal-confirm-icon">✓</div>
        <div class="modal-confirm-title">On its way.</div>
        <p class="modal-confirm-text">Check your inbox in the next few minutes. If you don't see it, check your spam folder and mark us as a trusted sender.</p>
      </div>
    </div>
  </div>

  <!-- SUGGEST A RESOURCE MODAL -->
  <div class="modal-overlay" id="suggest-overlay">
    <div class="modal">
      <button class="modal-close" id="suggest-close-btn">×</button>

      <!-- Request state -->
      <div id="suggest-request">
        <div class="modal-badges">
          <span class="resource-type-badge badge-template">Your Idea</span>
        </div>
        <div class="modal-title">Suggest a Resource.</div>
        <p class="modal-desc">Tell me what would actually help your business and I'll consider building it. You'll be added to the newsletter, so if I make it, it lands straight in your inbox.</p>
        <hr class="modal-divider" />
        <form
          name="suggest-a-resource"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          id="suggest-form"
        >
          <input type="hidden" name="form-name" value="suggest-a-resource" />
          <p class="suggest-hp">
            <label>Leave this field empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>
          <div class="suggest-field">
            <label class="suggest-label" for="suggest-name">Name</label>
            <input type="text" class="suggest-input" id="suggest-name" name="name" placeholder="Your name" />
          </div>
          <div class="suggest-field">
            <label class="suggest-label" for="suggest-email">Email <span class="suggest-req">*</span></label>
            <input type="email" class="suggest-input" id="suggest-email" name="email" placeholder="your@email.com" />
          </div>
          <div class="suggest-field">
            <label class="suggest-label" for="suggest-message">What should I build? <span class="suggest-req">*</span></label>
            <textarea class="suggest-textarea" id="suggest-message" name="suggestion" rows="4" placeholder="Describe the template, script, checklist, or tool you'd find useful…"></textarea>
          </div>
          <button type="submit" class="modal-submit suggest-submit" id="suggest-submit-btn">Send Suggestion →</button>
          <p class="modal-fine">You'll be added to the newsletter. No spam — ever.</p>
        </form>
      </div>

      <!-- Confirmation state -->
      <div class="modal-confirm" id="suggest-confirm">
        <div class="modal-confirm-icon">✓</div>
        <div class="modal-confirm-title">Got it.</div>
        <p class="modal-confirm-text">Thanks for the suggestion — I read every one. If I build it, you'll be among the first to know.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ resourcesData }}>
  // ─── Modal Logic ───────────────────────────────────────────────
  const overlay = document.getElementById('modal-overlay');
  const modalRequest = document.getElementById('modal-request');
  const modalConfirm = document.getElementById('modal-confirm');

  function openModal(id) {
    const r = resourcesData[id];
    if (!r) return;

    // Reset to request state
    modalRequest.style.display = 'block';
    modalConfirm.classList.remove('active');
    document.getElementById('modal-email').value = '';

    // Set badge
    const typeBadge = document.getElementById('modal-type-badge');
    typeBadge.textContent = r.type;
    typeBadge.className = 'resource-type-badge ' + r.typeBadge;

    document.getElementById('modal-pillar-badge').textContent = r.pillar;
    document.getElementById('modal-title').textContent = r.title;
    document.getElementById('modal-desc').textContent = r.desc;

    // Build includes list
    const list = document.getElementById('modal-includes-list');
    const wrap = document.getElementById('modal-includes-wrap');
    list.innerHTML = '';
    if (r.includes && r.includes.length) {
      wrap.style.display = 'block';
      r.includes.forEach(item => {
        const div = document.createElement('div');
        div.className = 'modal-includes-item';
        div.innerHTML = '<div class="modal-includes-dot"></div>' + item;
        list.appendChild(div);
      });
    } else {
      wrap.style.display = 'none';
    }

    overlay.classList.add('active');
    document.body.style.overflow = 'hidden';
    setTimeout(() => document.getElementById('modal-email').focus(), 250);
  }

  async function submitModal() {
    const email = document.getElementById('modal-email').value;
    if (!email || !email.includes('@')) {
      const input = document.getElementById('modal-email');
      input.focus();
      input.style.borderColor = '#e00055';
      setTimeout(() => { input.style.borderColor = ''; }, 1200);
      return;
    }

    // Subscribe to Beehiiv via the newsletter function (source: 'toolkit').
    // Graceful: confirmation still shows even if the request fails — e.g. in
    // local dev, where the Netlify function doesn't run.
    try {
      await fetch('/.netlify/functions/newsletter-subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email, source: 'toolkit' }),
      });
    } catch (err) {
      /* swallow — show confirmation regardless */
    }

    modalRequest.style.display = 'none';
    modalConfirm.classList.add('active');
  }

  function closeModal() {
    overlay.classList.remove('active');
    document.body.style.overflow = '';
  }

  // Wire up all "Send Me This" buttons (featured + grid)
  document.querySelectorAll('[data-resource-id]').forEach(btn => {
    btn.addEventListener('click', () => openModal(btn.dataset.resourceId));
  });

  document.getElementById('modal-close-btn').addEventListener('click', closeModal);
  document.getElementById('modal-submit-btn').addEventListener('click', submitModal);

  overlay.addEventListener('click', e => { if (e.target === overlay) closeModal(); });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeModal();
    if (e.key === 'Enter' && overlay.classList.contains('active')) submitModal();
  });

  // ─── Filter Logic ───────────────────────────────────────────────
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      const filter = this.dataset.filter;
      document.querySelectorAll('.resource-card').forEach(card => {
        if (filter === 'all' || card.dataset.type === filter) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });
</script>

<script is:inline>
  // ─── Suggest a Resource Modal ───────────────────────────────────
  (function () {
    const sOverlay = document.getElementById('suggest-overlay');
    if (!sOverlay) return;
    const sRequest = document.getElementById('suggest-request');
    const sConfirm = document.getElementById('suggest-confirm');
    const sForm = document.getElementById('suggest-form');
    const nameEl = document.getElementById('suggest-name');
    const emailEl = document.getElementById('suggest-email');
    const msgEl = document.getElementById('suggest-message');
    const submitBtn = document.getElementById('suggest-submit-btn');

    function openSuggest() {
      sRequest.style.display = 'block';
      sConfirm.classList.remove('active');
      sForm.reset();
      sOverlay.classList.add('active');
      document.body.style.overflow = 'hidden';
      setTimeout(function () { nameEl.focus(); }, 250);
    }

    function closeSuggest() {
      sOverlay.classList.remove('active');
      document.body.style.overflow = '';
    }

    function flagInvalid(el) {
      el.focus();
      el.style.borderColor = '#e00055';
      setTimeout(function () { el.style.borderColor = ''; }, 1200);
    }

    function encodeForm(data) {
      return Object.keys(data).map(function (k) {
        return encodeURIComponent(k) + '=' + encodeURIComponent(data[k]);
      }).join('&');
    }

    async function submitSuggest() {
      const name = nameEl.value.trim();
      const email = emailEl.value.trim();
      const suggestion = msgEl.value.trim();

      if (!email || !email.includes('@')) { flagInvalid(emailEl); return; }
      if (!suggestion) { flagInvalid(msgEl); return; }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';

      const botField = sForm.querySelector('[name="bot-field"]');
      const formData = {
        'form-name': 'suggest-a-resource',
        name: name,
        email: email,
        suggestion: suggestion,
        'bot-field': botField ? botField.value : ''
      };

      // Fire both in parallel: Netlify Forms (emails the suggestion to Chris)
      // and the Beehiiv function (subscribes the suggester to the newsletter).
      const tasks = [
        fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: encodeForm(formData)
        }),
        fetch('/.netlify/functions/newsletter-subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, source: 'toolkit-suggestion' })
        })
      ];

      await Promise.allSettled(tasks);

      // Always show confirmation — graceful in local dev, where neither
      // the Netlify Form handler nor the function runs.
      sRequest.style.display = 'none';
      sConfirm.classList.add('active');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send Suggestion →';
    }

    document.querySelectorAll('.suggest-btn').forEach(function (btn) {
      btn.addEventListener('click', openSuggest);
    });
    document.getElementById('suggest-close-btn').addEventListener('click', closeSuggest);
    sOverlay.addEventListener('click', function (e) { if (e.target === sOverlay) closeSuggest(); });
    sForm.addEventListener('submit', function (e) { e.preventDefault(); submitSuggest(); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && sOverlay.classList.contains('active')) closeSuggest();
    });
  })();
</script>

<style>
  /* HERO */
  .page-hero { background: var(--black); }
  .page-hero-inner {
    max-width: 1280px; margin: 0 auto; padding: 64px 40px 60px;
    display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: end;
  }
  .hero-eyebrow { font-family: 'Bebas Neue', cursive; font-size: 11px; letter-spacing: 0.2em; color: #444; margin-bottom: 12px; }
  .hero-h1 { font-family: 'Bebas Neue', cursive; font-size: 96px; line-height: 0.88; letter-spacing: 0.02em; color: var(--white); margin-bottom: 24px; }
  .hero-h1 em { color: var(--yellow); font-style: normal; }
  .hero-sub { font-family: 'DM Sans', sans-serif; font-size: 18px; line-height: 1.65; color: #666; font-style: italic; max-width: 480px; }
  .hero-right { padding-bottom: 8px; }
  .hero-stat-row { display: flex; flex-direction: column; gap: 24px; }
  .hero-stat-num { font-family: 'Bebas Neue', cursive; font-size: 48px; line-height: 0.9; color: var(--yellow); letter-spacing: 0.02em; }
  .hero-stat-label { font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #444; margin-top: 4px; }
  .hero-stat-divider { width: 40px; height: 1px; background: #1e1e1e; }

  /* HOW IT WORKS */
  .how-bar { background: #0d0d0d; border-bottom: 1px solid #1a1a1a; }
  .how-bar-inner { max-width: 1280px; margin: 0 auto; padding: 20px 40px; display: flex; align-items: center; gap: 40px; }
  .how-label { font-family: 'Bebas Neue', cursive; font-size: 11px; letter-spacing: 0.18em; color: #444; white-space: nowrap; flex-shrink: 0; }
  .how-steps { display: flex; gap: 0; flex: 1; }
  .how-step { display: flex; align-items: center; gap: 12px; flex: 1; padding: 0 24px; border-left: 1px solid #1e1e1e; }
  .how-step:first-child { border-left: none; padding-left: 0; }
  .how-step-num { font-family: 'Bebas Neue', cursive; font-size: 22px; color: var(--yellow); line-height: 1; flex-shrink: 0; }
  .how-step-text { font-family: 'Inter', sans-serif; font-size: 12px; color: #666; line-height: 1.4; }
  .how-step-text strong { color: #999; font-weight: 600; }

  /* FEATURED */
  .featured-section { background: var(--white); border-bottom: 1px solid var(--rule); }
  .featured-inner { max-width: 1280px; margin: 0 auto; padding: 56px 40px; }
  .featured-card {
    display: grid; grid-template-columns: 1fr 420px; gap: 0;
    border: 1px solid var(--rule); border-top: 4px solid var(--yellow);
  }
  .featured-content { padding: 40px; border-right: 1px solid var(--rule); }
  .featured-badges { display: flex; gap: 8px; align-items: center; margin-bottom: 20px; }
  .resource-type-badge { font-family: 'Bebas Neue', cursive; font-size: 10px; letter-spacing: 0.18em; padding: 3px 10px; display: inline-block; }
  .badge-template  { background: var(--yellow); color: var(--black); }
  .badge-script    { background: var(--black); color: var(--yellow); }
  .badge-checklist { background: var(--charcoal); color: var(--white); }
  .badge-calculator{ background: #2a2a2a; color: var(--white); }
  .badge-guide     { background: var(--yellow); color: var(--black); }
  .pillar-badge { font-family: 'Bebas Neue', cursive; font-size: 10px; letter-spacing: 0.14em; color: var(--gray); border: 1px solid var(--rule); padding: 3px 10px; }
  .featured-title { font-family: 'Bebas Neue', cursive; font-size: 52px; line-height: 0.92; letter-spacing: 0.02em; color: var(--black); margin-bottom: 16px; }
  .featured-desc { font-size: 16px; line-height: 1.75; color: var(--charcoal); margin-bottom: 28px; }
  .featured-includes { margin-bottom: 32px; }
  .includes-label { font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gray); margin-bottom: 10px; }
  .includes-list { display: flex; flex-direction: column; gap: 6px; }
  .includes-item { display: flex; align-items: flex-start; gap: 10px; font-size: 14px; line-height: 1.4; color: var(--charcoal); }
  .includes-dot { width: 8px; height: 8px; background: var(--yellow); flex-shrink: 0; margin-top: 4px; }
  .resource-cta-btn {
    background: var(--black); color: var(--yellow);
    font-family: 'Bebas Neue', cursive; font-size: 17px; letter-spacing: 0.09em;
    padding: 16px 32px; display: inline-flex; align-items: center; gap: 10px;
    cursor: pointer; border: none; transition: background 0.15s;
  }
  .resource-cta-btn:hover { background: #222; }
  .featured-visual {
    background: var(--black); position: relative; overflow: hidden;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
