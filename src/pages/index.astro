<script define:vars={{ tkResourcesData }}>
  const overlay   = document.getElementById('tk-modal-overlay');
  const reqPane   = document.getElementById('tk-modal-request');
  const confPane  = document.getElementById('tk-modal-confirm');

  function openModal(id) {
    const r = tkResourcesData[id];
    if (!r) return;

    reqPane.style.display = 'block';
    confPane.classList.remove('active');
    document.getElementById('tk-modal-email').value = '';

    const typeBadge = document.getElementById('tk-modal-type-badge');
    typeBadge.textContent = r.type;
    typeBadge.className = 'tk-modal-type-badge ' + r.typeBadge;

    document.getElementById('tk-modal-pillar-badge').textContent = r.pillar;
    document.getElementById('tk-modal-title').textContent = r.title;
    document.getElementById('tk-modal-desc').textContent = r.desc;

    const list = document.getElementById('tk-modal-includes-list');
    const wrap = document.getElementById('tk-modal-includes-wrap');
    list.innerHTML = '';
    if (r.includes && r.includes.length) {
      wrap.style.display = 'block';
      r.includes.forEach(item => {
        const div = document.createElement('div');
        div.className = 'tk-modal-includes-item';
        div.innerHTML = '<div class="tk-modal-includes-dot"></div>' + item;
        list.appendChild(div);
      });
    } else {
      wrap.style.display = 'none';
    }

    overlay.classList.add('active');
    document.body.style.overflow = 'hidden';
    setTimeout(() => document.getElementById('tk-modal-email').focus(), 250);
  }

  function submitModal() {
    const email = document.getElementById('tk-modal-email').value;
    if (!email || !email.includes('@')) {
      const input = document.getElementById('tk-modal-email');
      input.focus();
      input.style.borderColor = '#e00055';
      setTimeout(() => { input.style.borderColor = ''; }, 1200);
      return;
    }
    reqPane.style.display = 'none';
    confPane.classList.add('active');
  }

  function closeModal() {
    overlay.classList.remove('active');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('[data-resource-id]').forEach(btn => {
    btn.addEventListener('click', () => openModal(btn.dataset.resourceId));
  });

  document.getElementById('tk-modal-close').addEventListener('click', closeModal);
  document.getElementById('tk-modal-submit').addEventListener('click', submitModal);
  overlay.addEventListener('click', e => { if (e.target === overlay) closeModal(); });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeModal();
    if (e.key === 'Enter' && overlay.classList.contains('active')) submitModal();
  });
</script>
