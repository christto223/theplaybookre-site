---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import PillarStrip from '../components/PillarStrip.astro';
import NewsletterBand from '../components/NewsletterBand.astro';
import { PILLARS } from '../data/pillars';
import { MOST_READ_IDS } from '../data/mostRead';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const allToolkit = await getCollection('toolkit');
const homepageToolkit = allToolkit.sort((a, b) => a.data.order - b.data.order);

function tkCapitalize(s: string) { return s.charAt(0).toUpperCase() + s.slice(1); }
function tkBadgeClass(type: string) {
  return ({ template:'badge-template', script:'badge-script', checklist:'badge-checklist', calculator:'badge-calculator', guide:'badge-guide' })[type] ?? 'badge-template';
}
function tkTypeLabel(type: string) {
  return ({ template:'Template', script:'Script Pack', checklist:'Checklist', calculator:'Calculator', guide:'Free Guide' })[type] ?? tkCapitalize(type);
}
const tkIcons: Record<string, string> = {
  template: `<svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="4" y="8" width="40" height="32" rx="2" stroke="#FFD100" stroke-width="2"/><line x1="4" y1="16" x2="44" y2="16" stroke="#FFD100" stroke-width="1.5"/><line x1="4" y1="24" x2="44" y2="24" stroke="#FFD100" stroke-width="1.5"/><line x1="4" y1="32" x2="44" y2="32" stroke="#FFD100" stroke-width="1.5"/><line x1="16" y1="8" x2="16" y2="40" stroke="#FFD100" stroke-width="1.5"/><line x1="28" y1="8" x2="28" y2="40" stroke="#FFD100" stroke-width="1.5"/><rect x="5" y="9" width="10" height="6" fill="#FFD100" opacity="0.15"/><rect x="17" y="9" width="10" height="6" fill="#FFD100" opacity="0.15"/></svg>`,
  script:   `<svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="8" y="4" width="28" height="36" rx="2" stroke="#FFD100" stroke-width="2"/><line x1="14" y1="14" x2="30" y2="14" stroke="#FFD100" stroke-width="2" stroke-linecap="round"/><line x1="14" y1="20" x2="30" y2="20" stroke="#FFD100" stroke-width="2" stroke-linecap="round"/><line x1="14" y1="26" x2="22" y2="26" stroke="#FFD100" stroke-width="2" stroke-linecap="round"/><circle cx="36" cy="36" r="8" fill="#111" stroke="#FFD100" stroke-width="1.5"/><line x1="36" y1="32" x2="36" y2="40" stroke="#FFD100" stroke-width="1.5" stroke-linecap="round"/><line x1="32" y1="36" x2="40" y2="36" stroke="#FFD100" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  checklist:`<svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="6" y="4" width="36" height="40" rx="2" stroke="#FFD100" stroke-width="2"/><line x1="12" y1="15" x2="36" y2="15" stroke="#333" stroke-width="1"/><line x1="12" y1="22" x2="36" y2="22" stroke="#333" stroke-width="1"/><line x1="12" y1="29" x2="36" y2="29" stroke="#333" stroke-width="1"/><line x1="12" y1="36" x2="36" y2="36" stroke="#333" stroke-width="1"/><polyline points="14,14 17,18 22,11" stroke="#FFD100" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><polyline points="14,21 17,25 22,18" stroke="#FFD100" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><polyline points="14,28 17,32 22,25" stroke="#FFD100" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  guide:    `<svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="24" cy="24" r="18" stroke="#FFD100" stroke-width="2"/><polyline points="24,14 24,24 30,30" stroke="#FFD100" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><line x1="14" y1="8" x2="34" y2="8" stroke="#FFD100" stroke-width="1.5" stroke-linecap="round" opacity="0.4"/><line x1="10" y1="4" x2="38" y2="4" stroke="#FFD100" stroke-width="1" stroke-linecap="round" opacity="0.2"/></svg>`,
  calculator:`<svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="10" y="4" width="28" height="40" rx="2" stroke="#FFD100" stroke-width="2"/><rect x="14" y="10" width="20" height="10" rx="1" fill="#FFD100" opacity="0.15" stroke="#FFD100" stroke-width="1"/><line x1="14" y1="28" x2="18" y2="28" stroke="#FFD100" stroke-width="2" stroke-linecap="round"/><line x1="23" y1="28" x2="27" y2="28" stroke="#FFD100" stroke-width="2" stroke-linecap="round"/><line x1="14" y1="35" x2="18" y2="35" stroke="#FFD100" stroke-width="2" stroke-linecap="round"/><line x1="23" y1="35" x2="27" y2="35" stroke="#FFD100" stroke-width="2" stroke-linecap="round"/></svg>`,
};
const tkResourcesData = Object.fromEntries(
  homepageToolkit.map(r => [r.id, {
    type: tkCapitalize(r.data.resourceType),
    typeBadge: tkBadgeClass(r.data.resourceType),
    pillar: r.data.pillar,
    title: r.data.title,
    desc: r.data.description,
    includes: r.data.includes ?? [],
    format: r.data.format,
  }])
);
const sorted = allArticles.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

// Homepage featured = first article with featured:true, else most recent
const featured = sorted.find(a => a.data.featured) ?? sorted[0];
// Latest 5 (excluding featured)
const latest = sorted.filter(a => a.id !== featured?.id).slice(0, 5);
// Spotlight: lead generation pillar — large card + up to 3 small cards
const spotlightAll = allArticles
  .filter(a => a.data.pillar === 'lead-generation')
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const spotlightLg = spotlightAll[0];
const spotlightSm = spotlightAll.slice(1, 4);
// Most read — driven by manually curated MOST_READ_IDS; falls back to recent if ID not found
const mostRead = MOST_READ_IDS
  .map(id => allArticles.find(a => a.id === id + (id.endsWith('.md') ? '' : '.md') || a.id.replace(/\.mdx?$/, '') === id))
  .filter(Boolean)
  .slice(0, 5) as typeof allArticles;

function articleUrl(article: typeof allArticles[0]) {
  const parts = article.id.split('/');
  return `/${parts[0]}/${parts.slice(1).join('/')}/`;
}

function formatDate(d: Date) {
  return new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(d);
}

const lpPillarColors: Record<string, string> = {
  'lead-generation':          '#0e1a12',
  'marketing-and-branding':   '#1c1a0e',
  'sales-skills-and-scripts': '#1a0e0e',
  'business-systems':         '#0e0e1a',
  'ai-and-technology':        '#0a1a12',
  'mindset-and-performance':  '#1a0e14',
  'growth-and-scaling':       '#1a140e',
  'the-fundamentals':         '#131318',
};

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "The Playbook RE",
    "url": "https://theplaybookre.com",
    "description": "Strategy and systems for real estate agents who are serious about building a real business.",
    "author": { "@type": "Person", "name": "Chris Linsell" },
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Chris Linsell",
    "jobTitle": "Chief Marketing Officer",
    "worksFor": { "@type": "Organization", "name": "The Mitten Group" },
    "url": "https://chrislinsell.com",
  }
];
---

<BaseLayout
  title="The Playbook RE — Real Estate Strategy You Can Actually Use"
  description="Strategy, scripts, and systems for real estate agents who are serious about building a real business. Written by Chris Linsell, CMO of The Mitten Group."
  schema={schema}
>
  <!-- PILLAR STRIP -->
  <PillarStrip />

  <!-- FEATURED ARTICLE -->
  {featured && (
    <div class="home-featured">
      <div class="home-featured-inner">
        <div class="feat-content">
          <div class="feat-eyebrow">
            <span class="feat-badge">Featured</span>
            <span class="feat-label">{featured.data.tags[0]}</span>
          </div>
          <h2 class="feat-title">
            <a href={articleUrl(featured)} set:html={featured.data.title.replace(featured.data.accentWord ?? '___', `<em>${featured.data.accentWord}</em>`)} />
          </h2>
          <p class="feat-dek">{featured.data.description}</p>
          <div class="feat-meta">
            <div class="feat-author-chip">
              <div class="feat-avatar">CL</div>
              <span class="feat-author-name">Chris Linsell</span>
            </div>
            <span class="feat-dot">·</span>
            <span class="feat-meta-text">{featured.data.readTime} min read</span>
            <span class="feat-dot">·</span>
            <span class="feat-meta-text">{new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).format(featured.data.publishDate)}</span>
          </div>
          <a href={articleUrl(featured)} class="feat-cta">Read the Playbook →</a>
        </div>
        <div class="feat-image-panel">
          {featured.data.heroImage
            ? <img src={`/images/${featured.data.heroImage}`} alt={featured.data.title} />
            : <>
                <div class="feat-img-placeholder"></div>
                <div class="feat-img-word">{featured.data.accentWord?.toUpperCase() ?? 'READ'}</div>
                <div class="feat-img-badge">Article Image</div>
                <div class="feat-img-caption">Replace with article featured image</div>
              </>
          }
        </div>
      </div>
    </div>
  )}

  <!-- LATEST PLAYBOOKS + SIDEBAR -->
  <div class="lp-section-head">
    <div class="lp-title">Latest Playbooks</div>
    <a href="/playbooks/" class="lp-view-all">View All →</a>
  </div>

  <div class="lp-layout">

    <!-- MAIN FEED -->
    <div class="lp-feed">

      {latest[0] && (() => {
        const a = latest[0];
        const bg = lpPillarColors[a.data.pillar] ?? '#1a1a1a';
        const tag = PILLARS.find(p => p.slug === a.data.pillar)?.name ?? a.data.pillar;
        return (
          <a href={articleUrl(a)} class="lp-card-lg">
            <div class="lp-card-img" style={`background:${bg}`}>
              <div class="lp-img-badge">{a.data.tags[0]}</div>
              {a.data.accentWord && <span class="lp-img-word" style="font-size:100px">{a.data.accentWord.toUpperCase()}</span>}
            </div>
            <div class="lp-card-body">
              <div class="lp-cat-tag">{tag}</div>
              <h2 class="lp-card-h2" set:html={a.data.title.replace(a.data.accentWord ?? '___', `<em>${a.data.accentWord}</em>`)} />
              <p class="lp-card-excerpt">{a.data.description}</p>
              <div class="lp-card-foot">
                <span class="lp-byline">By <strong>Chris Linsell</strong> · {formatDate(a.data.publishDate)} · {a.data.readTime} min read</span>
                <span class="lp-read-link">Read →</span>
              </div>
            </div>
          </a>
        );
      })()}

      {latest[1] && (() => {
        const a = latest[1];
        const bg = lpPillarColors[a.data.pillar] ?? '#1a1a1a';
        const tag = PILLARS.find(p => p.slug === a.data.pillar)?.name ?? a.data.pillar;
        return (
          <a href={articleUrl(a)} class="lp-card-sm">
            <div class="lp-card-img lp-card-img--sm" style={`background:${bg}`}>
              <div class="lp-img-badge">{a.data.tags[0]}</div>
              {a.data.accentWord && <span class="lp-img-word" style="font-size:72px">{a.data.accentWord.toUpperCase()}</span>}
            </div>
            <div class="lp-card-body">
              <div class="lp-cat-tag">{tag}</div>
              <h3 class="lp-card-h3" set:html={a.data.title.replace(a.data.accentWord ?? '___', `<em>${a.data.accentWord}</em>`)} />
              <p class="lp-card-excerpt lp-card-excerpt--sm">{a.data.description}</p>
              <div class="lp-card-foot">
                <span class="lp-byline">By <strong>Chris Linsell</strong> · {formatDate(a.data.publishDate)} · {a.data.readTime} min read</span>
                <span class="lp-read-link">Read →</span>
              </div>
            </div>
          </a>
        );
      })()}

      {[latest[2], latest[3], latest[4]].map(a => a && (() => {
        const bg = lpPillarColors[a.data.pillar] ?? '#1a1a1a';
        const tag = PILLARS.find(p => p.slug === a.data.pillar)?.name ?? a.data.pillar;
        return (
          <a href={articleUrl(a)} class="lp-card-sm">
            <div class="lp-card-img lp-card-img--sm" style={`background:${bg}`}>
              <div class="lp-img-badge">{a.data.tags[0]}</div>
              {a.data.accentWord && <span class="lp-img-word" style="font-size:72px">{a.data.accentWord.toUpperCase()}</span>}
            </div>
            <div class="lp-card-body">
              <div class="lp-cat-tag">{tag}</div>
              <h3 class="lp-card-h3" set:html={a.data.title.replace(a.data.accentWord ?? '___', `<em>${a.data.accentWord}</em>`)} />
              <p class="lp-card-excerpt lp-card-excerpt--sm">{a.data.description}</p>
              <div class="lp-card-foot">
                <span class="lp-byline">By <strong>Chris Linsell</strong> · {formatDate(a.data.publishDate)} · {a.data.readTime} min read</span>
                <span class="lp-read-link">Read →</span>
              </div>
            </div>
          </a>
        );
      })())}

    </div><!-- /lp-feed -->

    <!-- SIDEBAR -->
    <div class="lp-sidebar">
      <div class="lp-sidebar-sticky">

        <!-- Newsletter -->
        <div class="lp-nl">
          <div class="lp-nl-eyebrow">The Playbook Newsletter</div>
          <h3 class="lp-nl-head">One Playbook.<br/><span>Every Week.</span></h3>
          <p class="lp-nl-sub">Strategy and systems for agents who are serious about building a real business. No fluff. Every Tuesday.</p>
          <input type="email" class="lp-nl-input" placeholder="your@email.com" />
          <button class="lp-nl-btn">Subscribe Free</button>
          <div class="lp-nl-note">Join 12,000+ agents. Unsubscribe anytime.</div>
        </div>

        <!-- Most Read -->
        {mostRead.length > 0 && (
          <div class="lp-most-read">
            <div class="lp-mr-head">
              <span>Most Read</span>
              <a href="/playbooks/">See All →</a>
            </div>
            {mostRead.map((a, i) => (
              <a href={articleUrl(a)} class="lp-mr-item">
                <div class="lp-mr-num">{String(i + 1).padStart(2, '0')}</div>
                <div class="lp-mr-body">
                  <div class="lp-mr-cat">{PILLARS.find(p => p.slug === a.data.pillar)?.shortName ?? a.data.tags[0]}</div>
                  <h4 class="lp-mr-title">{a.data.title}</h4>
                  <div class="lp-mr-meta">{a.data.readTime} min read</div>
                </div>
              </a>
            ))}
          </div>
        )}

      </div>
    </div><!-- /lp-sidebar -->

  </div><!-- /lp-layout -->

  <!-- SPOTLIGHT: LEAD GENERATION -->
  <section class="sp-section">
    <div class="sp-inner">

      <div class="sp-header">
        <div>
          <div class="sp-label">Spotlight</div>
          <div class="sp-title">Lead <span>Generation</span></div>
          <div class="sp-desc">The strategies, systems, and scripts that build a pipeline that never runs dry.</div>
        </div>
        <a href="/lead-generation/" class="sp-link">All Lead Generation Playbooks</a>
      </div>

      <div class="sp-grid">

        {spotlightLg && (
          <a href={articleUrl(spotlightLg)} class="sp-card-lg">
            <div class="sp-img-tall">
              {spotlightLg.data.accentWord && (
                <span class="sp-img-word">{spotlightLg.data.accentWord.toUpperCase()}</span>
              )}
              <div class="sp-img-badge">{spotlightLg.data.tags[0]}</div>
            </div>
            <div class="sp-body">
              <div class="sp-cat-tag">{PILLARS.find(p => p.slug === spotlightLg.data.pillar)?.name ?? 'Lead Generation'}</div>
              <h3 class="sp-h3" set:html={spotlightLg.data.title.replace(spotlightLg.data.accentWord ?? '___', `<em>${spotlightLg.data.accentWord}</em>`)} />
              <p class="sp-excerpt">{spotlightLg.data.description}</p>
              <span class="sp-read">Read the Playbook</span>
            </div>
          </a>
        )}

        {spotlightSm.map(a => (
          <a href={articleUrl(a)} class="sp-card-sm">
            <div class="sp-img-med">
              {a.data.accentWord && (
                <span class="sp-img-word sp-img-word--sm">{a.data.accentWord.toUpperCase()}</span>
              )}
              <div class="sp-img-badge">{a.data.tags[0]}</div>
            </div>
            <div class="sp-body">
              <div class="sp-cat-tag">{a.data.tags[0]}</div>
              <h4 class="sp-h4" set:html={a.data.title.replace(a.data.accentWord ?? '___', `<em>${a.data.accentWord}</em>`)} />
              <span class="sp-read">Read the Playbook</span>
            </div>
          </a>
        ))}

      </div>
    </div>
  </section>

  <!-- THE TOOLKIT -->
  <section class="tk-section">
    <div class="tk-inner">
      <div class="tk-header">
        <div>
          <div class="tk-label">Templates, Scripts &amp; Downloads</div>
          <div class="tk-title">The <span>Toolkit</span></div>
          <div class="tk-subtitle">Ready-to-use templates, checklists, and script packs. Download any of them free — just your email.</div>
        </div>
        <a href="/toolkit/" class="tk-link">All Free Resources</a>
      </div>
      <div class="tk-grid">
        {homepageToolkit.map(resource => (
          <div class="tk-card">
            <div class="tk-card-icon" set:html={tkIcons[resource.data.resourceType] ?? tkIcons.template} />
            <div class="tk-body">
              <div class="tk-type-badge">{tkTypeLabel(resource.data.resourceType)}</div>
              <h3>{resource.data.title}</h3>
              <p>{resource.data.description}</p>
              <div class="tk-cta">
                <button class="tk-cta-btn" data-resource-id={resource.id}>Download Free</button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- NEWSLETTER BAND -->
  <NewsletterBand />

  <!-- TOOLKIT DOWNLOAD MODAL -->
  <div class="tk-modal-overlay" id="tk-modal-overlay">
    <div class="tk-modal">
      <button class="tk-modal-close" id="tk-modal-close">×</button>
      <div id="tk-modal-request">
        <div class="tk-modal-badges">
          <span class="tk-modal-type-badge" id="tk-modal-type-badge">Template</span>
          <span class="tk-modal-pillar-badge" id="tk-modal-pillar-badge">Business Systems</span>
        </div>
        <div class="tk-modal-title" id="tk-modal-title">Loading...</div>
        <p class="tk-modal-desc" id="tk-modal-desc"></p>
        <div class="tk-modal-includes" id="tk-modal-includes-wrap">
          <span class="tk-modal-includes-label">What's included</span>
          <div class="tk-modal-includes-list" id="tk-modal-includes-list"></div>
        </div>
        <hr class="tk-modal-divider" />
        <span class="tk-modal-form-label">Enter your email and we'll send it right over</span>
        <div class="tk-modal-form">
          <input type="email" class="tk-modal-input" id="tk-modal-email" placeholder="your@email.com" />
          <button class="tk-modal-submit" id="tk-modal-submit">Send Me This →</button>
        </div>
        <p class="tk-modal-fine">Free. Delivered to your inbox. No spam — ever.</p>
      </div>
      <div class="tk-modal-confirm" id="tk-modal-confirm">
        <div class="tk-modal-confirm-icon">✓</div>
        <div class="tk-modal-confirm-title">On its way.</div>
        <p class="tk-modal-confirm-text">Check your inbox in the next few minutes. If you don't see it, check your spam folder and mark us as a trusted sender.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* FEATURED HERO */
  .home-featured { background: var(--black); border-bottom: 1px solid #1f1f1f; }
  .home-featured-inner {
    max-width: 1280px; margin: 0 auto; padding: 0 40px;
    display: grid; grid-template-columns: 1fr 420px; min-height: 520px;
  }
  .feat-content {
    padding: 56px 48px 56px 0; display: flex; flex-direction: column;
    justify-content: center; border-right: 1px solid #1f1f1f;
  }
  .feat-eyebrow { display: flex; align-items: center; gap: 10px; margin-bottom: 24px; }
  .feat-badge {
    font-family: 'Bebas Neue', cursive; font-size: 12px; letter-spacing: 0.2em;
    background: var(--yellow); color: var(--black); padding: 3px 10px;
  }
  .feat-label {
    font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase; color: #555;
  }
  .feat-title {
    font-family: 'Bebas Neue', cursive; font-size: 82px; line-height: 0.9;
    letter-spacing: 0.02em; color: var(--white); margin-bottom: 28px;
  }
  .feat-title a { color: inherit; text-decoration: none; }
  .feat-title a:hover { color: var(--yellow); }
  .feat-title :global(em) { color: var(--yellow); font-style: normal; }
  .feat-dek { font-size: 17px; line-height: 1.65; color: #aaa; max-width: 560px; margin-bottom: 36px; }
  .feat-meta { display: flex; align-items: center; gap: 20px; margin-bottom: 32px; flex-wrap: wrap; }
  .feat-author-chip { display: flex; align-items: center; gap: 9px; }
  .feat-avatar {
    width: 32px; height: 32px; border-radius: 50%; background: var(--yellow);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Bebas Neue', cursive; font-size: 13px; color: var(--black); flex-shrink: 0;
  }
  .feat-author-name { font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 600; color: #ccc; }
  .feat-dot { color: #444; font-size: 12px; }
  .feat-meta-text { font-family: 'Inter', sans-serif; font-size: 12px; color: #666; }
  .feat-cta {
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--yellow); color: var(--black);
    font-family: 'Bebas Neue', cursive; font-size: 18px; letter-spacing: 0.1em;
    padding: 14px 36px; text-decoration: none; width: fit-content;
    transition: background 0.15s;
  }
  .feat-cta:hover { background: #e8be00; }
  .feat-image-panel {
    position: relative; overflow: hidden; background: #0a0a0a;
    display: flex; align-items: center; justify-content: center;
  }
