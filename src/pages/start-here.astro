---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterBand from '../components/NewsletterBand.astro';
import { PILLARS } from '../data/pillars';

// Pillars with at least one published article. The guided "Start Here" paths
// will return once there's real content across each career stage; until then
// this routes new readers straight to what's live.
const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const livePillars = PILLARS.filter(p => allArticles.some(a => a.data.pillar === p.slug));
---

<BaseLayout
  title="Start Here — Coming Soon"
  description="A guided starting path through The Playbook is in the works. In the meantime, dive into the playbooks that are live."
  activeNav="start-here"
  noindex={true}
>
  <!-- HERO -->
  <div class="page-hero">
    <div class="hero-inner">
      <span class="hero-eyebrow">Welcome to The Playbook RE</span>
      <h1 class="hero-h1">Start <em>Here</em>.</h1>
      <span class="hero-badge">Coming Soon</span>
      <p class="hero-sub">A guided path through the playbook — built around exactly where you are in your career — is in the works. While I finish it, here's the fastest way in.</p>
    </div>
  </div>

  <!-- WHAT'S LIVE -->
  <div class="sh-section">
    <div class="sh-inner">
      <div class="sh-head-row">
        <div>
          <div class="section-label">Start With What's Live</div>
          <h2 class="sh-h2">Dive Into What's <em>Published</em>.</h2>
        </div>
        <p class="sh-intro">These two sections are built out in full — every playbook researched, field-tested, and written to be used. The rest of the catalog is on its way.</p>
      </div>

      <div class="sh-grid">
        {livePillars.map(p => (
          <a href={`/${p.slug}/`} class="sh-card">
            <div class="sh-card-name">{p.name}</div>
            <div class="sh-card-desc">{p.description}</div>
            <div class="sh-card-link">Browse Playbooks →</div>
          </a>
        ))}
        <a href="/playbooks/" class="sh-card sh-card--all">
          <div class="sh-card-name">Every Playbook</div>
          <div class="sh-card-desc">Prefer to browse the whole archive? See everything published so far, newest first.</div>
          <div class="sh-card-link">View the Archive →</div>
        </a>
      </div>
    </div>
  </div>

  <!-- NEWSLETTER BAND -->
  <NewsletterBand />
</BaseLayout>

<style>
  /* HERO */
  .page-hero { background: var(--black); }
  .hero-inner { max-width: 800px; margin: 0 auto; padding: 80px 40px 72px; text-align: center; }
  .hero-eyebrow { font-family: 'Bebas Neue', cursive; font-size: 11px; letter-spacing: 0.22em; color: #444; margin-bottom: 20px; display: block; }
  .hero-h1 { font-family: 'Bebas Neue', cursive; font-size: 96px; line-height: 0.88; letter-spacing: 0.02em; color: var(--white); margin-bottom: 24px; }
  .hero-h1 em { color: var(--yellow); font-style: normal; }
  .hero-badge {
    font-family: 'Bebas Neue', cursive; font-size: 13px; letter-spacing: 0.18em;
    color: var(--black); background: var(--yellow); padding: 6px 16px;
    display: inline-flex; align-items: center; gap: 9px; margin-bottom: 24px;
  }
  .hero-badge::before { content: ''; width: 7px; height: 7px; background: var(--black); border-radius: 50%; }
  .hero-sub { font-family: 'DM Sans', sans-serif; font-size: 19px; line-height: 1.7; color: #666; max-width: 540px; margin: 0 auto; }

  /* WHAT'S LIVE */
  .sh-section { background: var(--off-white); }
  .sh-inner { max-width: 1280px; margin: 0 auto; padding: 64px 40px 72px; }
  .sh-head-row { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: end; margin-bottom: 40px; }
  .sh-h2 { font-family: 'Bebas Neue', cursive; font-size: 52px; line-height: 0.92; letter-spacing: 0.02em; color: var(--black); margin-top: 16px; }
  .sh-h2 em { color: var(--yellow); font-style: normal; }
  .sh-intro { font-size: 16px; line-height: 1.75; color: var(--charcoal); padding-bottom: 6px; }

  .sh-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; background: var(--rule); }
  .sh-card {
    background: var(--white); border-top: 4px solid var(--yellow);
    padding: 32px 30px; display: flex; flex-direction: column;
    text-decoration: none; color: inherit; transition: background 0.12s;
  }
  .sh-card:hover { background: #fafaf8; }
  .sh-card--all { border-top-color: var(--black); }
  .sh-card-name {
    font-family: 'Bebas Neue', cursive; font-size: 30px; line-height: 0.95;
    letter-spacing: 0.02em; color: var(--black); margin-bottom: 12px; transition: color 0.12s;
  }
  .sh-card:hover .sh-card-name { color: var(--yellow); }
  .sh-card-desc {
    font-family: 'DM Sans', sans-serif; font-size: 14px; line-height: 1.65;
    color: var(--charcoal); flex: 1; margin-bottom: 20px;
  }
  .sh-card-link { font-family: 'Bebas Neue', cursive; font-size: 14px; letter-spacing: 0.1em; color: var(--black); }
  .sh-card:hover .sh-card-link { color: var(--yellow); }

  @media (max-width: 900px) {
    .sh-head-row { grid-template-columns: 1fr; gap: 20px; }
    .sh-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .hero-h1 { font-size: 64px; }
    .hero-inner { padding: 56px 20px 48px; }
    .sh-inner { padding: 48px 20px 56px; }
    .sh-h2 { font-size: 40px; }
  }
</style>
