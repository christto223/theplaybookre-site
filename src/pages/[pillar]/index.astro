---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PillarStrip from '../../components/PillarStrip.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { PILLARS, getPillarBySlug } from '../../data/pillars';

export async function getStaticPaths() {
  const allArticles = await getCollection('articles', ({ data }) => !data.draft);
  return PILLARS.map(pillar => ({
    params: { pillar: pillar.slug },
    props:  {
      pillarData: pillar,
      articles: allArticles
        .filter(a => a.data.pillar === pillar.slug)
        .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()),
    },
  }));
}

const { pillarData, articles } = Astro.props;
const featuredArticle = articles.find(a => a.data.featured) ?? articles[0];
const gridArticles    = articles.filter(a => a.id !== featuredArticle?.id);

function articleUrl(article: typeof articles[0]) {
  const parts = article.id.split('/');
  return `/${parts[0]}/${parts.slice(1).join('/')}/`;
}

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${pillarData.name} — The Playbook RE`,
  "description": pillarData.description,
  "url": `https://theplaybookre.com/${pillarData.slug}/`,
};
---

<BaseLayout
  title={`${pillarData.name} Playbooks`}
  description={pillarData.description}
  schema={schema}
>
  <!-- PILLAR STRIP -->
  <PillarStrip activePillar={pillarData.slug} />

  <!-- PILLAR HERO -->
  <div class="pillar-hero">
    <div class="pillar-hero-inner">
      <div class="pillar-eyebrow">The Playbook RE</div>
      <h1 class="pillar-name">{pillarData.name}</h1>
      <p class="pillar-desc">{pillarData.description}</p>
      <div class="pillar-count">{articles.length} {articles.length === 1 ? 'Playbook' : 'Playbooks'}</div>
    </div>
  </div>

  <!-- FEATURED ARTICLE -->
  {featuredArticle && (
    <div class="featured-section">
      <div class="featured-inner">
        <div class="section-label">Featured Playbook</div>
        <div class="featured-card">
          <div class="featured-content">
            <div class="featured-tag">
              <span class="feat-tag-pill">{featuredArticle.data.tags[0]}</span>
            </div>
            <h2 class="featured-title">
              <a href={articleUrl(featuredArticle)}>{featuredArticle.data.title}</a>
            </h2>
            <p class="featured-excerpt">{featuredArticle.data.description}</p>
            <div class="featured-meta">
              By Chris Linsell · {featuredArticle.data.readTime} min read
            </div>
            <a href={articleUrl(featuredArticle)} class="featured-cta">Read the Playbook →</a>
          </div>
          <div class="featured-image">
            {featuredArticle.data.heroImage
              ? <img src={`/images/${featuredArticle.data.heroImage}`} alt={featuredArticle.data.title} />
              : <div class="featured-image-placeholder"></div>
            }
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- FILTER BAR + GRID -->
  <div class="catalog-section">
    <div class="catalog-inner">
      <div class="catalog-bar">
        <div class="filter-tabs">
          <button class="filter-tab active" data-filter="all">All Playbooks</button>
          <button class="filter-tab" data-filter="popular">Most Popular</button>
        </div>
        <div class="article-count">Showing {gridArticles.length} of {articles.length}</div>
      </div>

      {gridArticles.length > 0 ? (
        <div class="article-grid" id="article-grid">
          {gridArticles.map(article => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              pillar={article.data.pillar}
              primaryTag={article.data.tags[0] ?? pillarData.name}
              readTime={article.data.readTime}
              slug={article.id}
              heroImage={article.data.heroImage}
              accentWord={article.data.accentWord}
            />
          ))}
        </div>
      ) : (
        <div class="empty-grid">
          <p>More playbooks coming soon. <a href="/start-here/">Start here</a> in the meantime.</p>
        </div>
      )}
    </div>
  </div>

  <!-- NEWSLETTER BAND -->
  <div class="newsletter-band">
    <div class="nl-inner">
      <div class="nl-top">
        <div class="nl-headline">Build the Business.<br />Run the Play.</div>
        <div class="nl-sub">One playbook in your inbox every Tuesday. Strategy, scripts, and systems for agents who are serious about building a real business.</div>
      </div>
      <div class="nl-stats">
        <div><div class="nl-stat-num">12,400+</div><div class="nl-stat-label">Agents subscribed</div></div>
        <div><div class="nl-stat-num">Every Tuesday</div><div class="nl-stat-label">Delivery schedule</div></div>
        <div><div class="nl-stat-num">Free</div><div class="nl-stat-label">Always</div></div>
      </div>
      <div class="nl-form">
        <input class="nl-input" type="email" placeholder="your@email.com" />
        <button class="nl-btn">Subscribe to the Newsletter</button>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* PILLAR HERO */
  .pillar-hero { background: var(--black); }
  .pillar-hero-inner {
    max-width: 1280px; margin: 0 auto; padding: 56px 40px 52px;
    display: flex; flex-direction: column; align-items: flex-start;
  }
  .pillar-eyebrow {
    font-family: 'Bebas Neue', cursive; font-size: 11px; letter-spacing: 0.2em;
    color: #333; margin-bottom: 12px;
  }
  .pillar-name {
    font-family: 'Bebas Neue', cursive; font-size: 100px; line-height: 0.88;
    letter-spacing: 0.02em; color: var(--white); margin-bottom: 20px;
  }
  .pillar-desc {
    font-family: 'DM Sans', sans-serif; font-size: 18px; line-height: 1.6;
    color: #666; font-style: italic; max-width: 560px; margin-bottom: 20px;
  }
  .pillar-count {
    font-family: 'Bebas Neue', cursive; font-size: 13px; letter-spacing: 0.12em;
    color: var(--yellow); background: rgba(255,209,0,0.1);
    border: 1px solid rgba(255,209,0,0.2); padding: 4px 14px;
  }

  /* FEATURED */
  .featured-section { background: var(--white); border-bottom: 1px solid var(--rule); }
  .featured-inner { max-width: 1280px; margin: 0 auto; padding: 48px 40px; }
  .featured-card {
    display: grid; grid-template-columns: 1fr 480px; gap: 0;
    border-top: 4px solid var(--yellow);
    border: 1px solid var(--rule); border-top: 4px solid var(--yellow);
    margin-top: 20px;
  }
  .featured-content {
    padding: 36px; border-right: 1px solid var(--rule);
    display: flex; flex-direction: column;
  }
  .feat-tag-pill {
    font-family: 'Bebas Neue', cursive; font-size: 10px; letter-spacing: 0.18em;
    color: var(--yellow); background: var(--black); padding: 2px 10px;
    display: inline-block; margin-bottom: 16px;
  }
  .featured-title {
    font-family: 'Bebas Neue', cursive; font-size: 44px; line-height: 0.92;
    letter-spacing: 0.02em; color: var(--black); margin-bottom: 14px;
  }
  .featured-title a { color: inherit; text-decoration: none; transition: color 0.12s; }
  .featured-title a:hover { color: var(--yellow); }
  .featured-excerpt {
    font-size: 15px; line-height: 1.7; color: var(--charcoal);
    margin-bottom: 16px; flex: 1;
  }
  .featured-meta {
    font-family: 'Inter', sans-serif; font-size: 11px; color: var(--gray);
    margin-bottom: 24px;
  }
  .featured-cta {
    font-family: 'Bebas Neue', cursive; font-size: 15px; letter-spacing: 0.08em;
    color: var(--black); border-bottom: 2px solid var(--yellow);
    padding-bottom: 2px; text-decoration: none; align-self: flex-start;
    transition: color 0.12s;
  }
  .featured-cta:hover { color: var(--yellow); border-bottom-color: transparent; }
  .featured-image { overflow: hidden; }
  .featured-image img { width: 100%; height: 100%; object-fit: cover; }
  .featured-image-placeholder { width: 100%; height: 100%; min-height: 300px; background: #1a1a1a; }

  /* CATALOG */
  .catalog-section { background: var(--off-white); }
  .catalog-inner { max-width: 1280px; margin: 0 auto; padding: 48px 40px 72px; }
  .catalog-bar {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 28px;
  }
  .filter-tabs { display: flex; gap: 0; }
  .filter-tab {
    font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    padding: 9px 20px; background: var(--white); color: var(--gray);
    border: 1px solid var(--rule); border-right: none;
    cursor: pointer; transition: all 0.12s;
  }
  .filter-tab:last-child { border-right: 1px solid var(--rule); }
  .filter-tab:hover { color: var(--black); }
  .filter-tab.active { background: var(--black); color: var(--yellow); border-color: var(--black); }
  .article-count {
    font-family: 'Inter', sans-serif; font-size: 12px; color: var(--gray);
  }
  .article-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 2px; background: var(--rule);
  }
  .empty-grid {
    padding: 60px; text-align: center;
    font-family: 'DM Sans', sans-serif; font-size: 16px; color: var(--gray);
  }
  .empty-grid a { color: var(--black); border-bottom: 1px solid var(--yellow); }
</style>
